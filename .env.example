# Telegram alerts (optional). Copy to `.env` and fill in.
#
# 1. Open your bot in Telegram and send it any message (e.g. "hi").
# 2. Run:  npm run telegram:chats
# 3. Copy the numeric id shown under "Use in .env" (NOT the bot id).
#
# Wrong: TELEGRAM_CHAT_ID = same number as the start of the bot token (that is the bot).
# Right:  your personal chat id (positive) or group id (often negative).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard login via Telegram (same bot). User opens t.me link and clicks Start.
# Session cookie lasts 7 days. Set DASHBOARD_AUTH=0 to disable.
DASHBOARD_AUTH=1
# Optional: public URL for links (e.g. https://your-app.railway.app)
# DASHBOARD_PUBLIC_URL=
# Optional: only these Telegram user ids may log in (comma-separated)
# TELEGRAM_AUTH_ALLOW_IDS=
# DASHBOARD_AUTH_SECRET=

# Set to 1 to also post NEAR-break setups (not full SIGNAL)
TELEGRAM_NOTIFY_NEAR=0

# Daily paper-bot summary to Telegram (UTC+3). Opt-in: TELEGRAM_PAPER_BOT_REPORT=1
# PAPER_BOT_REPORT_HOUR=8
# PAPER_BOT_REPORT_MINUTE=0

# Binance USDT-M Futures — positions panel + live bot (requires Futures TRADE permission)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Persistent storage (caches, scanner results, history comments, UI prefs, scanner config).
# scanner-config.json — live indicator thresholds (survives restarts)
# ui-settings.json — tab filters, calculations, search fields, mover form prefs
# Local default: ./.cache
# Railway: attach a volume (e.g. mount /app/data) — RAILWAY_VOLUME_MOUNT_PATH is set automatically.
# DATA_DIR=/app/data
