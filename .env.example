# Telegram alerts (optional). Copy to `.env` and fill in.
#
# 1. Open your bot in Telegram and send it any message (e.g. "hi").
# 2. Run:  npm run telegram:chats
# 3. Copy the numeric id shown under "Use in .env" (NOT the bot id).
#
# Wrong: TELEGRAM_CHAT_ID = same number as the start of the bot token (that is the bot).
# Right:  your personal chat id (positive) or group id (often negative).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set to 1 to also post NEAR-break setups (not full SIGNAL)
TELEGRAM_NOTIFY_NEAR=0
